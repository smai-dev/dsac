      "source": [
        "# Matplotlib Visualization : Histogram of Life Expectancy\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.hist(df['lifeExp'], bins=20, color='purple', edgecolor='black')\n",
        "plt.title('Histogram of Life Expectancy')\n",
        "plt.xlabel('Life Expectancy')\n",
        "plt.ylabel('Frequency')\n",
        "plt.grid(axis='y')\n",
        "plt.show()"
      ]
    },
