      "source": [
        "# Matplotlib Visualization: Bar plot of Mean GDP per Capita by Continent\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "df.groupby('continent')['gdpPercap'].mean().plot(kind='bar', color='skyblue')\n",
        "plt.title('Mean GDP per Capita by Continent')\n",
        "plt.xlabel('Continent')\n",
        "plt.ylabel('Mean GDP per Capita')\n",
        "plt.xticks(rotation=45)\n",
        "plt.grid(axis='y')\n",
        "plt.show()"
      ]
    },
