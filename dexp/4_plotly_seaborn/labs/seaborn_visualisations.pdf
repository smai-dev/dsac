      "source": [
        "# 9. Regression plot for Life Expectancy vs GDP per Capita\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.regplot(x='gdpPercap', y='lifeExp', data=df)\n",
        "plt.title('Regression Plot of Life Expectancy vs GDP per Capita')\n",
        "plt.show()\n"
