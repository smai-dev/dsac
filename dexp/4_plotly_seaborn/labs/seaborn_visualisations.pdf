      },
      "outputs": [],
      "source": [
        "# Matplotlib Visualization: Scatter plot of GDP per Capita vs Life Expectancy\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.scatter(df['gdpPercap'], df['lifeExp'], alpha=0.5, color='orange')\n",
        "plt.title('GDP per Capita vs Life Expectancy')\n",
        "plt.xlabel('GDP per Capita')\n",
        "plt.ylabel('Life Expectancy')\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
    },
