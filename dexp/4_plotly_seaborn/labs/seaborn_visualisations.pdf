      ],
      "source": [
        "# Matplotlib Visualization : Line plot of Life Expectancy over Years\n",
        "plt.figure(figsize=(10, 6))\n",
        "for continent in df['continent'].unique():\n",
        "    df_continent = df[df['continent'] == continent]\n",
        "    plt.plot(df_continent['year'], df_continent['lifeExp'], label=continent)\n",
        "plt.title('Life Expectancy over Years by Continent')\n",
        "plt.xlabel('Year')\n",
        "plt.ylabel('Life Expectancy')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
    },
