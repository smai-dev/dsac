      "source": [
        "# 7. FacetGrid of Life Expectancy vs GDP per Capita across continents\n",
        "g = sns.FacetGrid(df, col='country', col_wrap=3)\n",
        "g.map(sns.scatterplot, 'gdpPercap', 'lifeExp')\n",
        "g.fig.suptitle('Scatter Plot of Life Expectancy vs GDP per Capita (Faceted by Continent)', y=1.02)\n",
        "plt.show()"
      ]
    },
