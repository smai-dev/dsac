      "source": [
        "# 1. Pairplot for selected columns\n",
        "sns.pairplot(df[['year', 'lifeExp', 'gdpPercap', 'pop']])\n",
        "plt.title('Pairplot of Year, Life Expectancy, GDP per Capita, and Population')\n",
        "plt.show()"
      ]
    },
