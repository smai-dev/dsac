      "source": [
        "# Interactive line plot using Plotly Express\n",
        "fig = px.line(df, x='year', y='lifeExp', color='continent', title='Life Expectancy over Years by Continent')\n",
        "fig.update_layout(xaxis_title='Year', yaxis_title='Life Expectancy')\n",
        "fig.show()"
      ]
    },
