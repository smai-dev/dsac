      "source": [
        "# 8. Pointplot of Life Expectancy vs Year across continents\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.pointplot(x='year', y='lifeExp', hue='continent', data=df, dodge=True, errorbar=None)\n",
        "plt.title('Point Plot of Life Expectancy vs Year (Faceted by Continent)')\n",
        "plt.show()"
      ]
    },
