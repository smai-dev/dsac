      "source": [
        "import plotly.express as px\n",
        "\n",
        "fig = px.strip(df, x='year', y='lifeExp', color='country', title='Swarm Plot of Life Expectancy across Years')\n",
        "fig.update_traces(jitter=1)  # Adjust jitter for better visibility\n",
        "fig.show()"
